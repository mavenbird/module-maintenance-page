<script>
/* ── Star particles ── */
(function(){
    var c = document.getElementById('cs-stars');
    if (!c) return;
    for (var i = 0; i < 80; i++) {
        var s = document.createElement('div');
        s.className = 'cs-star';
        var size = Math.random() * 2.5 + .5;
        s.style.cssText = [
            'width:'+size+'px','height:'+size+'px',
            'top:'+Math.random()*100+'%',
            'left:'+Math.random()*100+'%',
            '--dur:'+(Math.random()*3+2)+'s',
            '--delay:-'+(Math.random()*4)+'s',
            'opacity:'+(Math.random()*.6+.1)
        ].join(';');
        c.appendChild(s);
    }
})();

/* ── Countdown & subscribe hooks ── */
window.mvEndTime      = <?= $endTs ?>;
window.mvSubscribeUrl = '<?= $subUrl ?>';
window.mvBtnLabel     = '<?= $btnLabel ?>';
window.mvIsComingSoon = true;

/* Map old countdown IDs used by countdown.js */
window.addEventListener('load', function () {
    /* progress bar */
    var bar = document.getElementById('mv-progress-bar');
    if (bar) setTimeout(function(){ bar.style.width = bar.getAttribute('data-value')+'%'; }, 600);

    /* subscribe button */
    var btn = document.getElementById('mv-subscribe-btn');
    var inp = document.getElementById('mv-email');
    var msg = document.getElementById('mv-subscribe-msg');
    if (btn && inp && msg) {
        btn.addEventListener('click', function () {
            var email = inp.value.trim();
            if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                msg.textContent = '<?= __("Please enter a valid email address.") ?>';
                msg.className = 'cs-sub-msg error';
                msg.style.display = 'inline-block';
                return;
            }
            btn.disabled = true;
            btn.textContent = '<?= __("Subscribing...") ?>';
            fetch(window.mvSubscribeUrl, {
                method:'POST',
                headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
                body:JSON.stringify({email:email})
            }).then(function(r){ return r.json(); })
              .then(function(d){
                if (d && d.success) {
                    msg.textContent = d.message || '<?= __("Thank you for subscribing!") ?>';
                    msg.className = 'cs-sub-msg success';
                    inp.value = '';
                } else {
                    msg.textContent = (d && d.message) || '<?= __("Something went wrong.") ?>';
                    msg.className = 'cs-sub-msg error';
                }
                msg.style.display = 'inline-block';
                btn.disabled = false;
                btn.textContent = window.mvBtnLabel;
              })
              .catch(function(){
                msg.textContent = '<?= __("Something went wrong.") ?>';
                msg.className = 'cs-sub-msg error';
                msg.style.display = 'inline-block';
                btn.disabled = false;
                btn.textContent = window.mvBtnLabel;
              });
        });
    }
});
</script>
